# LAD Django backend environment — copy to LAD/lad/.env and fill in.
#
#   cp LAD/lad/.env.example LAD/lad/.env
#
# NOTE: .env / .env.* are gitignored. This template is tracked; if `git add`
# ignores it, force it once with:  git add -f LAD/lad/.env.example
#
# In development you can leave .env absent entirely — settings.py uses safe
# LAN-only defaults (DEBUG=True, ALLOWED_HOSTS=['*'], a dev SECRET_KEY).
# For ANY public / tunnel deployment you MUST set the values below. With
# DJANGO_DEBUG=false the app fails fast if SECRET_KEY is missing/insecure or
# ALLOWED_HOSTS is missing/contains '*', and turns on HTTPS security settings.

# --- Required for public deployments ------------------------------------------

# Strong random key. Generate one, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# The committed dev key is PUBLIC — never reuse it; rotate to a fresh value.
DJANGO_SECRET_KEY=

# false on any public/tunnel deployment (defaults to True for LAN dev).
DJANGO_DEBUG=false

# Exact hostname(s), comma-separated, NO '*'. e.g. lad.example.com,www.lad.example.com
DJANGO_ALLOWED_HOSTS=

# Full https origin(s) of the public site — added to CSRF + CORS trust. Exact match.
#   e.g. https://lad.example.com
DJANGO_EXTRA_ORIGINS=

# --- Account gating -----------------------------------------------------------
# Require an invite code to register. Non-empty = gated (share only with testers);
# empty = open registration.
REGISTRATION_INVITE_CODE=

# --- Network / IP -------------------------------------------------------------
# Real IPs live here or in config/ip_config.json (both gitignored) — never in
# code. Unset, the app falls back to 127.0.0.1, which is safe but non-functional
# for LAN/robot use. start-all.sh autodetects and writes EXPOSED_IP for you.
EXPOSED_IP=
# LAN address of the physical QCar (rosbridge :9090 + cameras :8080).
QCAR_IP=

# --- Physical QCar SSH credentials --------------------------------------------
# Default to the Quanser factory creds (nvidia/nvidia) for local dev. Change the
# robot's password and set these before exposing the app off the local network.
QCAR_USERNAME=nvidia
QCAR_PASSWORD=nvidia

# --- Notes --------------------------------------------------------------------
# DATABASE_URL is NOT read by settings.py (the DB engine is hardcoded SQLite).
# Switching to PostgreSQL requires editing core/settings.py DATABASES.
